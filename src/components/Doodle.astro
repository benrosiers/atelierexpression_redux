const { name, color = 'ink', class: className = '' } = Astro.props;
const markup = PATHS[name];
---

<svg
  class={`doodle doodle--${color} ${className}`}
  viewBox="0 0 100 100"
  fill="none"
  stroke="currentColor"
  stroke-width="3"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={markup}
/>

<style lang="scss">
  @use '../styles/tokens' as *;

  .doodle {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;

    &--ink    { color: $c-ink; }
    &--pink   { color: $c-pink-dk; }
    &--orange { color: $c-orange; }
    &--cream  { color: $c-cream; }
  }
</style>
