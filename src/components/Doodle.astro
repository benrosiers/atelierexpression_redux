    <path d="M50 92 C 42 76, 20 58, 20 38 C 20 18, 34 6, 50 6 C 66 6, 80 18, 80 38 C 80 58, 58 76, 50 92 Z" />
    <circle cx="50" cy="38" r="11" stroke-width="3" />
