---
// Hand-drawn SVG doodle system — replaces every Unicode emoji used as a
// pictogram. Deliberately irregular paths (no perfect circles/rects), round
// caps/joins, three ink colors only. viewBox is always 0 0 100 100 so every
// doodle drops in at any size via width/height.
interface Props {
  name: keyof typeof PATHS;
  color?: 'ink' | 'pink' | 'orange' | 'cream';
  class?: string;
}

const PATHS = {
  butterfly: `
    <path d="M49 38 C 44 20, 24 8, 11 16 C 1 22, 4 38, 18 42 C 30 45, 42 42, 49 38" />
