---
import BaseLayout from '../../components/BaseLayout.astro';
import {
  activities,
  activityTypes,
  activityStatuses,
  formatActivityDate,
  formatPrice,
  type Activity,
} from '../../lib/reduxActivities';

export function getStaticPaths() {
  return activities.map((activity) => ({
    params: { slug: activity.slug },
    props: { activity },
  }));
}

const { activity } = Astro.props as { activity: Activity };
---

<BaseLayout
  title={activity.title}
  description={activity.summary}
>
  <section class="redux-detail container">
    <a class="back" href="/calendrier/">
      ← Retour au calendrier
    </a>

    <p class="eyebrow">
      {activityTypes[activity.type]}
    </p>

    <h1>{activity.title}</h1>

    <p class="intro">{activity.summary}</p>

    <div class="details">
      <div class="main">
        <h2>À propos de cette activité</h2>

        <p>{activity.description}</p>

        <h2>Informations pratiques</h2>

        <dl>
          <dt>Date</dt>
          <dd>{formatActivityDate(activity.startsAt)}</dd>

          <dt>Fin</dt>
          <dd>{formatActivityDate(activity.endsAt)}</dd>

          <dt>Lieu</dt>
          <dd>{activity.location}</dd>

          <dt>Animation</dt>
          <dd>{activity.host}</dd>

          <dt>Prix</dt>
          <dd>{formatPrice(activity.priceCents)}</dd>

          <dt>Capacité</dt>
          <dd>{activity.capacity} personnes</dd>
        </dl>
      </div>

      <aside class="booking" aria-labelledby="booking-title">
        <p class="status">
          {activityStatuses[activity.status]}
        </p>

        <h2 id="booking-title">Participer</h2>

        <p>
          Le paiement se fera sur place.
          Aucun paiement en ligne n'est demandé.
        </p>

        <p>
          Le service d'inscription Redux n'est pas
          encore activé. Aucune place ne peut être
          réservée depuis cette page pour le moment.
        </p>

        <a class="contact" href="/contact/">
          Poser une question
        </a>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .redux-detail {
    padding-top: 3rem;
    padding-bottom: 6rem;
    max-width: 1100px;
    margin-inline: auto;
  }

  .back {
    display: inline-block;
    margin-bottom: 3rem;
    color: #d4237a;
  }

  .eyebrow {
    color: #d4237a;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  h1 {
    font-family: Georgia, serif;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1.1;
    margin: 1rem 0;
  }

  .intro {
    font-size: 1.2rem;
    max-width: 680px;
    line-height: 1.7;
  }

  .details {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 3rem;
    margin-top: 4rem;
  }

  .main h2 {
    margin-top: 2rem;
    font-family: Georgia, serif;
    font-size: 1.6rem;
  }

  .main p {
    white-space: pre-line;
    line-height: 1.8;
  }

  dl {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr);
    gap: 1rem;
    margin-top: 2rem;
  }

  dt {
    font-weight: 800;
  }

  dd {
    margin: 0;
  }

  .booking {
    align-self: start;
    padding: 2rem;
    border-radius: 1rem;
    background: #1c1c2e;
    color: white;
  }

  .booking h2 {
    color: white;
    margin: 1rem 0;
  }

  .booking p {
    line-height: 1.7;
  }

  .status {
    color: #f2b92d;
    font-weight: 800;
  }

  .contact {
    display: inline-block;
    margin-top: 1rem;
    padding: .8rem 1.4rem;
    background: #d4237a;
    color: white;
    border-radius: 2rem;
    text-decoration: none;
  }

  @media (max-width: 760px) {
    .redux-detail {
      padding-inline: 1rem;
    }

    .details {
      grid-template-columns: 1fr;
    }
  }
</style>