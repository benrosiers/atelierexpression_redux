---
// /admin/events edits the single next_workshop record — see
// docs/NEXT_WORKSHOP_CONTENT_MODEL.md. There is exactly one "event" on this
// site today (the next workshop's scheduling status); once genuinely
// distinct dated events exist, this becomes a real list+edit pair like
// /admin/workshops.
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Événements" activeNav="events">
  <h1>Événements</h1>
  <p class="admin-page-sub">
    Le statut du prochain atelier — ce qui pilote la page Réserver (formulaire d'intérêt vs.
    réservation) partout sur le site. Le texte du bouton ci-dessous s'affiche tant que le statut
    est « En préparation »; une fois une date ou des inscriptions actives, le bouton du menu
    affiche automatiquement « Réserver » — les autres pages du site, elles, n'ont pas encore
    ce changement automatique de texte (voir la note dans docs/admin/content-inventory.md).
  </p>

  <div id="event-editor-root">
    <p class="admin-empty-note">Chargement…</p>
  </div>

  <style>
    .event-form {
      display: grid;
      gap: 1rem;
      max-width: 640px;
    }
    .event-form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    .status-warning {
      background: #FFF4E0;
      border: 1px solid #E5C77A;
      border-radius: 8px;
      padding: 0.8em 1em;
      font-size: 0.85rem;
      color: #6B4A00;
      margin-bottom: 1rem;
    }
  </style>

  <script>
    import { getNextWorkshopRow, updateNextWorkshop, updateNextWorkshopTranslation } from '../../../lib/content/nextWorkshop';
    import { isSupabaseConfigured } from '../../../lib/supabase/client';

    const root = document.getElementById('event-editor-root')!;
    const STATUSES = [
      { value: 'building', label: 'En préparation (aucune date)' },
      { value: 'date-announced', label: 'Date annoncée' },
      { value: 'registration-open', label: 'Inscriptions ouvertes' },
      { value: 'sold-out', label: 'Complet' },
      { value: 'completed', label: 'Terminé' },
    ];

    function notify(message: string, kind: 'success' | 'error') {
      const container = document.getElementById('admin-notifications');
      if (!container) return;
      const el = document.createElement('div');
      el.className = `admin-notice admin-notice--${kind}`;
      el.textContent = message;
      container.appendChild(el);
      setTimeout(() => el.remove(), 4000);
    }

    async function render() {
      if (!isSupabaseConfigured()) {
        root.innerHTML = '<p class="admin-empty-note">CMS non configuré.</p>';
        return;
      }

      const nw = await getNextWorkshopRow();
      if (!nw) {
        root.innerHTML = `<p class="admin-empty-note">Aucune donnée trouvée.</p>`;
        return;
      }

      root.innerHTML = `
        ${nw.status === 'building' ? `
          <div class="status-warning">
            Statut actuel : <strong>en préparation</strong>, aucune date. Le site affiche
            partout « Être averti·e du prochain atelier ». Pour activer les réservations,
            passe le statut à « Date annoncée » ou « Inscriptions ouvertes » et remplis une date.
          </div>
        ` : ''}

        <div class="event-form">
          <div class="admin-form-field">
            <label for="ef-status">Statut</label>
            <select id="ef-status">
              ${STATUSES.map((s) => `<option value="${s.value}" ${nw.status === s.value ? 'selected' : ''}>${s.label}</option>`).join('')}
            </select>
          </div>

          <div class="event-form-row">
            <div class="admin-form-field">
              <label for="ef-date">Date</label>
              <input type="date" id="ef-date" value="${nw.event_date ?? ''}" />
            </div>
            <div class="admin-form-field">
              <label for="ef-time">Heure (texte libre, ex. « 19h00 »)</label>
              <input type="text" id="ef-time" value="${(nw.event_time ?? '').replace(/"/g, '&quot;')}" />
            </div>
          </div>

          <div class="admin-form-field">
            <label for="ef-location">Lieu</label>
            <input type="text" id="ef-location" value="${(nw.location ?? '').replace(/"/g, '&quot;')}" />
          </div>

          <div class="event-form-row">
            <div class="admin-form-field">
              <label for="ef-capacity">Capacité (texte libre, ex. « 10 à 15 personnes »)</label>
              <input type="text" id="ef-capacity" value="${(nw.capacity ?? '').replace(/"/g, '&quot;')}" />
            </div>
            <div class="admin-form-field">
              <label for="ef-price">Prix ($ CA)</label>
              <input type="number" id="ef-price" step="0.01" min="0" value="${nw.price_cents != null ? (nw.price_cents / 100).toFixed(2) : ''}" />
            </div>
          </div>

          <div class="admin-form-field">
            <label for="ef-registration-url">URL de réservation (externe, optionnel)</label>
            <input type="text" id="ef-registration-url" value="${(nw.registration_url ?? '').replace(/"/g, '&quot;')}" />
          </div>

          <div class="admin-form-field">
            <label for="ef-cta-label">Texte du bouton (visible tant que « En préparation »)</label>
            <input type="text" id="ef-cta-label" value="${(nw.cta_label ?? '').replace(/"/g, '&quot;')}" />
          </div>

          <div class="admin-form-field">
            <label for="ef-short-description">Description courte</label>
            <textarea id="ef-short-description" rows="2">${nw.short_description ?? ''}</textarea>
          </div>

          <div class="admin-form-field">
            <label for="ef-details">Détails</label>
            <textarea id="ef-details" rows="5">${nw.details ?? ''}</textarea>
          </div>

          <div>
            <button type="button" class="admin-btn admin-btn--primary" id="ef-save-btn">Enregistrer</button>
          </div>
        </div>
      `;

      document.getElementById('ef-save-btn')?.addEventListener('click', async () => {
        const btn = document.getElementById('ef-save-btn') as HTMLButtonElement;
        btn.disabled = true;

        const priceInput = (document.getElementById('ef-price') as HTMLInputElement).value;
        const dateInput = (document.getElementById('ef-date') as HTMLInputElement).value;

        const fieldsResult = await updateNextWorkshop(nw.id, {
          status: (document.getElementById('ef-status') as HTMLSelectElement).value as any,
          event_date: dateInput || null,
          event_time: (document.getElementById('ef-time') as HTMLInputElement).value || null,
          location: (document.getElementById('ef-location') as HTMLInputElement).value || null,
          capacity: (document.getElementById('ef-capacity') as HTMLInputElement).value || null,
          price_cents: priceInput ? Math.round(parseFloat(priceInput) * 100) : null,
          registration_url: (document.getElementById('ef-registration-url') as HTMLInputElement).value || null,
        });

        const translationResult = await updateNextWorkshopTranslation(nw.id, {
          cta_label: (document.getElementById('ef-cta-label') as HTMLInputElement).value,
          short_description: (document.getElementById('ef-short-description') as HTMLTextAreaElement).value,
          details: (document.getElementById('ef-details') as HTMLTextAreaElement).value,
        });

        btn.disabled = false;
        const ok = fieldsResult.ok && translationResult.ok;
        notify(ok ? 'Enregistré.' : `Erreur : ${fieldsResult.error ?? translationResult.error}`, ok ? 'success' : 'error');
        if (ok) render();
      });
    }

    render();
  </script>
</AdminLayout>
