---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Témoignages" activeNav="testimonials">
  <h1>Témoignages</h1>
  <p class="admin-page-sub">Affichés sur la page d'accueil et sur /temoignages.</p>

  <div class="admin-card">
    <table class="admin-table" id="testimonials-table">
      <thead>
        <tr>
          <th>Extrait</th>
          <th>Initiales</th>
          <th>Statut</th>
          <th>Placeholder</th>
          <th>Visible</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="testimonials-tbody">
        <tr><td colspan="6" class="admin-empty-note">Chargement…</td></tr>
      </tbody>
    </table>
  </div>

  <style>
    .admin-page-sub { color: #6B6255; font-size: 0.9rem; margin: -0.5rem 0 1.5rem; }
    .admin-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    .admin-table th { text-align: left; padding: 0.6em 0.8em; border-bottom: 2px solid #E5E2DA; color: #6B6255; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; }
    .admin-table td { padding: 0.7em 0.8em; border-bottom: 1px solid #EFEDE7; }
    .status-pill { display: inline-block; padding: 0.2em 0.7em; border-radius: 999px; font-size: 0.75rem; font-weight: 700; }
    .status-pill--published { background: #E4F5E9; color: #1E5C33; }
    .status-pill--draft { background: #FFF4E0; color: #6B4A00; }
    .status-pill--archived { background: #EDEBE6; color: #6B6255; }
    .placeholder-pill { display: inline-block; padding: 0.2em 0.7em; border-radius: 999px; font-size: 0.75rem; font-weight: 700; background: #FFF4E0; color: #6B4A00; }
  </style>

  <script>
    import { listTestimonials } from '../../../lib/content/testimonials';
    import { isSupabaseConfigured } from '../../../lib/supabase/client';

    async function render() {
      const tbody = document.getElementById('testimonials-tbody');
      if (!tbody) return;

      if (!isSupabaseConfigured()) {
        tbody.innerHTML = '<tr><td colspan="6" class="admin-empty-note">CMS non configuré.</td></tr>';
        return;
      }

      const testimonials = await listTestimonials();
      if (testimonials.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="admin-empty-note">Aucun témoignage pour l\'instant.</td></tr>';
        return;
      }

      tbody.innerHTML = testimonials.map((t) => {
        const excerpt = (t.quote ?? '').slice(0, 60) + ((t.quote ?? '').length > 60 ? '…' : '');
        return `
          <tr>
            <td>"${excerpt}"</td>
            <td>${t.author_initials ?? '—'}</td>
            <td><span class="status-pill status-pill--${t.status}">${t.status}</span></td>
            <td>${t.is_placeholder ? '<span class="placeholder-pill">placeholder</span>' : '—'}</td>
            <td>${t.visible ? '✓' : '—'}</td>
            <td><a href="/admin/testimonials/edit?id=${t.id}" class="admin-btn admin-btn--ghost">Modifier</a></td>
          </tr>
        `;
      }).join('');
    }

    render();
  </script>
</AdminLayout>
