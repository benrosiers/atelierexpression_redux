---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Nouvel atelier" activeNav="workshops">
  <h1>Nouvel atelier</h1>
  <div class="admin-card">
    <div class="admin-form-field">
      <label for="new-slug">Identifiant (slug, sans espaces ni accents)</label>
      <input type="text" id="new-slug" placeholder="mon-nouvel-atelier" />
    </div>
    <div class="admin-form-field">
      <label for="new-title">Titre</label>
      <input type="text" id="new-title" placeholder="Titre de l'atelier" />
    </div>
    <button type="button" class="admin-btn admin-btn--primary" id="create-btn">Créer (brouillon)</button>
  </div>

  <script>
    import { getSupabaseClient, isSupabaseConfigured } from '../../../lib/supabase/client';

    function notify(message: string, kind: 'success' | 'error') {
      const container = document.getElementById('admin-notifications');
      if (!container) return;
      const el = document.createElement('div');
      el.className = `admin-notice admin-notice--${kind}`;
      el.textContent = message;
      container.appendChild(el);
      setTimeout(() => el.remove(), 4000);
    }

    document.getElementById('create-btn')?.addEventListener('click', async () => {
      if (!isSupabaseConfigured()) { notify('CMS non configuré.', 'error'); return; }
      const slug = (document.getElementById('new-slug') as HTMLInputElement).value.trim();
      const title = (document.getElementById('new-title') as HTMLInputElement).value.trim();

      if (!/^[a-z0-9-]+$/.test(slug)) {
        notify('Identifiant invalide : lettres minuscules, chiffres et tirets seulement.', 'error');
        return;
      }

      const client = getSupabaseClient();
      const { data: workshop, error } = await client!
        .from('workshops')
        .insert({ slug, status: 'draft', visible: false })
        .select('id').single();

      if (error || !workshop) {
        notify(`Erreur : ${error?.message ?? 'inconnue'}`, 'error');
        return;
      }

      const { data: frLocale } = await client!.from('locales').select('id').eq('code', 'fr-CA').single();
      await client!.from('workshop_translations').insert({ workshop_id: workshop.id, locale_id: frLocale.id, title });

      window.location.href = `/admin/workshops/edit?id=${workshop.id}`;
    });
  </script>
</AdminLayout>
