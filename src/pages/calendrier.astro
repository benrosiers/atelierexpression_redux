---
import BaseLayout from '../components/BaseLayout.astro';
import {
  activities,
  activityTypes,
  activityStatuses,
  formatActivityDate,
  formatPrice,
} from '../lib/reduxActivities';

const calendarData = activities.map((activity) => ({
  slug: activity.slug,
  title: activity.title,
  date: activity.startsAt.slice(0, 10),
}));

const initialMonth = new Date().toLocaleDateString(
  'en-CA',
  { timeZone: 'America/Toronto', year: 'numeric', month: '2-digit' }
);
---

<BaseLayout
  title="Calendrier social"
  description="Ateliers, rencontres et gym social."
>
  <section class="redux-calendar container">
    <header class="intro">
      <p class="eyebrow">
        On rit. On joue. On s'exprime.
      </p>

      <h1>Le calendrier social</h1>

      <p>
        Des activités pour se rencontrer,
        bouger, jouer et prendre sa place.
      </p>
    </header>

    <div
      id="redux-calendar"
      class="calendar-panel"
      data-activities={JSON.stringify(calendarData)}
      data-initial-month={initialMonth}
    >
      <div class="calendar-toolbar">
        <button
          id="redux-previous"
          type="button"
          aria-label="Mois précédent"
        >
          ←
        </button>

        <h2 id="redux-month" aria-live="polite">
          Calendrier
        </h2>

        <button
          id="redux-next"
          type="button"
          aria-label="Mois suivant"
        >
          →
        </button>
      </div>

      <div class="weekdays" aria-hidden="true">
        <span>Lun</span>
        <span>Mar</span>
        <span>Mer</span>
        <span>Jeu</span>
        <span>Ven</span>
        <span>Sam</span>
        <span>Dim</span>
      </div>

      <div
        id="redux-days"
        class="calendar-days"
        aria-label="Jours du mois"
      ></div>
    </div>

    <section class="activity-list" aria-labelledby="activities-heading">
      <h2 id="activities-heading">Les activités</h2>

      {activities.length === 0 ? (
        <div class="empty">
          <h3>La programmation se prépare.</h3>

          <p>
            Aucune activité n'a encore de date
            confirmée dans le calendrier Redux.
          </p>

          <a href="/contact/">
            Nous contacter →
          </a>
        </div>
      ) : (
        <div class="activity-grid">
          {activities.map((activity) => (
            <article class="activity-card">
              <span class="category">
                {activityTypes[activity.type]}
              </span>

              <h3>{activity.title}</h3>

              <time datetime={activity.startsAt}>
                {formatActivityDate(activity.startsAt)}
              </time>

              <p>{activity.summary}</p>

              <p class="meta">
                {activity.location} · {formatPrice(activity.priceCents)}
              </p>

              <p class="status">
                {activityStatuses[activity.status]}
              </p>

              <a href={`/activites/${activity.slug}/`}>
                Voir les détails →
              </a>
            </article>
          ))}
        </div>
      )}
    </section>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('#redux-calendar');
  const monthLabel = document.querySelector<HTMLElement>('#redux-month');
  const days = document.querySelector<HTMLElement>('#redux-days');

  if (root && monthLabel && days) {
    const entries: Array<{
      slug: string;
      title: string;
      date: string;
    }> = JSON.parse(root.dataset.activities ?? '[]');

    const initial = root.dataset.initialMonth ?? '2026-09';

    const [initialYear, initialMonth] = initial.split('-').map(Number);

    const displayed = new Date(
      initialYear,
      initialMonth - 1,
      1
    );

    function render() {
      if (!monthLabel || !days) return;

      days.replaceChildren();

      const year = displayed.getFullYear();
      const month = displayed.getMonth();

      monthLabel.textContent = displayed.toLocaleDateString(
        'fr-CA',
        {
          month: 'long',
          year: 'numeric',
        }
      );

      const offset = (
        new Date(year, month, 1).getDay() + 6
      ) % 7;

      const count = new Date(
        year,
        month + 1,
        0
      ).getDate();

      for (let i = 0; i < offset; i++) {
        const blank = document.createElement('span');
        blank.setAttribute('aria-hidden', 'true');
        days.append(blank);
      }

      for (let day = 1; day <= count; day++) {
        const date = [
          year,
          String(month + 1).padStart(2, '0'),
          String(day).padStart(2, '0'),
        ].join('-');

        const cell = document.createElement('div');
        cell.className = 'calendar-day';

        const number = document.createElement('strong');
        number.textContent = String(day);
        cell.append(number);

        for (const entry of entries) {
          if (entry.date !== date) continue;

          const link = document.createElement('a');
          link.href = `/activites/${entry.slug}/`;
          link.textContent = entry.title;
          link.className = 'calendar-event';

          cell.append(link);
        }

        days.append(cell);
      }
    }

    document.querySelector('#redux-previous')?.addEventListener(
      'click',
      () => {
        displayed.setMonth(displayed.getMonth() - 1);
        render();
      }
    );

    document.querySelector('#redux-next')?.addEventListener(
      'click',
      () => {
        displayed.setMonth(displayed.getMonth() + 1);
        render();
      }
    );

    render();
  }
</script>

<style is:global>
  .redux-calendar {
    max-width: 1100px;
    margin-inline: auto;
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .redux-calendar .eyebrow {
    color: #d4237a;
    font-weight: 800;
  }

  .redux-calendar .intro h1 {
    font-family: Georgia, serif;
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 1.1;
    margin: 1rem 0;
  }

  .redux-calendar .intro > p:last-child {
    max-width: 680px;
    font-size: 1.2rem;
    line-height: 1.7;
  }

  .calendar-panel {
    padding: 2rem;
    margin-top: 3rem;
    background: #fff;
    border-radius: 1.3rem;
    border: 1px solid #ded5d8;
  }

  .calendar-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .calendar-toolbar h2 {
    text-transform: capitalize;
    text-align: center;
    font-size: clamp(1.1rem, 3vw, 2rem);
  }

  .calendar-toolbar button {
    border: 0;
    background: #d4237a;
    color: #fff;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    font-size: 1.5rem;
    cursor: pointer;
    flex-shrink: 0;
  }

  .weekdays,
  .calendar-days {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: .3rem;
  }

  .weekdays {
    text-align: center;
    font-weight: 800;
    padding-bottom: .7rem;
  }

  .calendar-day {
    min-height: 95px;
    border: 1px solid #e8dfe2;
    border-radius: .5rem;
    padding: .5rem;
    background: #faf8f6;
  }

  .calendar-event {
    display: block;
    background: #f9deeb;
    color: #8b1650;
    border-radius: .3rem;
    font-size: .8rem;
    padding: .3rem;
    margin-top: .4rem;
    overflow-wrap: anywhere;
  }

  .activity-list {
    padding-top: 4rem;
  }

  .activity-list > h2 {
    font-family: Georgia, serif;
    font-size: clamp(1.8rem, 4vw, 3rem);
    margin-bottom: 2rem;
  }

  .activity-grid {
    display: grid;
    grid-template-columns: repeat(
      auto-fit,
      minmax(min(100%, 300px), 1fr)
    );
    gap: 1.5rem;
  }

  .activity-card,
  .empty {
    padding: 2rem;
    background: #fff;
    border: 1px solid #ded5d8;
    border-radius: 1rem;
  }

  .activity-card h3,
  .empty h3 {
    font-family: Georgia, serif;
    font-size: 1.5rem;
    margin: 1rem 0;
  }

  .activity-card p,
  .empty p {
    line-height: 1.7;
  }

  .category {
    color: #d4237a;
    font-weight: 800;
  }

  .activity-card .meta {
    font-weight: 700;
  }

  .activity-card .status {
    color: #1a8f7f;
  }

  .activity-card a,
  .empty a {
    color: #d4237a;
    font-weight: 800;
  }

  @media (max-width: 600px) {
    .redux-calendar {
      padding-inline: 1rem;
    }

    .calendar-panel {
      padding: .6rem;
    }

    .calendar-day {
      min-height: 52px;
      padding: .2rem;
      font-size: .8rem;
    }

    .weekdays {
      font-size: .75rem;
    }

    .calendar-event {
      font-size: .65rem;
    }
  }
</style>