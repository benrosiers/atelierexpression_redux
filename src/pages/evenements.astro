---
import BaseLayout from '../components/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { events as staticEvents } from '../data/events';
import { getEvents, getSectionItems } from '../lib/content/publicContent';

const cmsEvents = await getEvents();
const events = cmsEvents.length > 0 ? cmsEvents : staticEvents;

const staticFormats = [
  { icon: '✦', title: 'Ateliers réguliers', desc: 'Notre format phare — 2 heures, petit groupe, récurrence mensuelle ou bimensuelle selon la demande.', status: 'Lancement imminent', color: 'fuchsia' },
  { icon: '🎭', title: 'Soirées thématiques', desc: 'Des soirées autour d\'un thème : rire et absurde, voix et présence, impro légère, connexion entre inconnu·es.', status: 'En préparation', color: 'corail' },
  { icon: '🏢', title: 'Ateliers privés', desc: 'Pour les groupes d\'ami·es, les familles, les équipes. Un atelier sur mesure dans un espace de ton choix.', status: 'Disponible sur demande', color: 'soleil' },
  { icon: '💼', title: 'Ateliers corporatifs', desc: 'Pour les équipes qui veulent s\'exprimer autrement. Cohésion, communication, présence, confiance.', status: 'Bientôt disponible', color: 'emeraude' },
];
const cmsFormats = await getSectionItems('evenements', 'formats');
const formats = cmsFormats.length > 0
  ? cmsFormats.map((i) => ({ icon: i.iconKey ?? '✦', title: i.title ?? '', desc: i.body ?? '', status: i.label ?? '', color: i.visualVariant ?? 'fuchsia' }))
  : staticFormats;
---

<BaseLayout
  title="Événements"
  description="Ateliers, soirées thématiques, et événements spéciaux Atelier Expression. Dates à venir — inscris-toi à l'infolettre pour être informé·e en premier."
  pageSlug="evenements"
>
  <PageHero
    accent="le calendrier"
    title="Événements"
    subtitle="Ateliers réguliers, soirées thématiques, et événements spéciaux. Les premières dates arrivent bientôt."
  />

  <!-- ─── UPCOMING ────────────────────────────────────────────────────────── -->
  <section class="section events-scene" aria-labelledby="events-heading">
    <div class="paint-scene" aria-hidden="true">
      <div class="paint-totem events-totem" style="--paint-totem-color:#FFC6A8; --paint-totem-tilt:3deg;"></div>
      <div class="paint-ellipse paint-ellipse--long events-mass" style="top:14%; --paint-ellipse-color:#F02E8A; --paint-ellipse-tilt:-2deg; --paint-ellipse-bias:-50%; --paint-ellipse-opacity:0.16;"></div>
    </div>
    <div class="container">
      <span class="accent-handwritten">dates à venir</span>
      <h2 id="events-heading">Ce qui s'en vient</h2>
      <div class="divider"></div>

      <div class="events-list" data-reveal>
        {events.map((event, i) => (
          <article class:list={['paint-panel', i % 2 === 0 ? 'paint-panel--peach' : 'paint-panel--pink', 'event-card']} style={`--panel-tilt:${i % 2 === 0 ? -1 : 1}deg;`}>
            <div class="event-card__status">
              {event.status === 'announced-soon' && <span class="paint-pastille paint-pastille--dark event-badge">Annonce imminente</span>}
              {event.status === 'upcoming' && <span class="paint-pastille paint-pastille--orange event-badge">Inscriptions ouvertes</span>}
            </div>
            <div class="event-card__body">
              <h3 class="event-card__title">{event.title}</h3>
              {event.date ? (
                <p class="event-card__date">
                  <span aria-hidden="true">📅</span> {event.date}
                  {event.time && ` à ${event.time}`}
                </p>
              ) : (
                <p class="event-card__date event-card__date--tbd">
                  <span aria-hidden="true">📅</span> Date à confirmer
                </p>
              )}
              <p class="event-card__location">
                <span aria-hidden="true">📍</span> {event.location}
              </p>
              <p class="event-card__price">
                <span aria-hidden="true">💰</span> {event.price}
              </p>
              <p class="event-card__description">{event.description}</p>
              <a href={event.href} class="btn btn--primary">
                {event.status === 'announced-soon' ? 'M\'inscrire à l\'infolettre' : 'Réserver ma place'}
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="events-empty-state" data-reveal>
        <div class="events-empty-inner">
          <span class="events-empty-icon" aria-hidden="true">✦</span>
          <h3>D'autres dates arrivent.</h3>
          <p>Inscris-toi à l'infolettre pour être la première personne informée des nouvelles dates et formats.</p>
          <a href="/communaute" class="btn btn--primary" style="margin-top: 1.5rem;">Rejoindre la communauté</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── EVENT FORMATS ────────────────────────────────────────────────────── -->
  <section class="section band band--gris" aria-labelledby="formats-heading">
    <div class="container">
      <div style="text-align: center; margin-bottom: 3rem;">
        <span class="accent-handwritten">les formats</span>
        <h2 id="formats-heading">Ce qui se prépare</h2>
        <div class="divider divider--center"></div>
      </div>

      <div class="formats-grid">
        {formats.map((format, i) => (
          <div
            class:list={['paint-panel', `paint-panel--${['orange','pink','peach','pink'][i % 4]}`, 'format-card']}
            style={`--panel-tilt:${[-1.3, 1, -0.7, 1.2][i % 4]}deg;`}
          >
            <span class="format-card__icon" aria-hidden="true">{format.icon}</span>
            <h3 class="format-card__title">{format.title}</h3>
            <p class="format-card__desc">{format.desc}</p>
            <span class="paint-pastille paint-pastille--cream format-card__status">{format.status}</span>
          </div>
        ))}
      </div>

      <div class="formats-glimpse" data-reveal>
        <img
          src="/assets/images/cindy_group_03.png"
          alt="Un atelier en mouvement"
          class="formats-glimpse__img"
          width="320"
          height="200"
          loading="lazy"
        />
        <p class="formats-glimpse__caption">À quoi ça ressemble, en vrai.</p>
      </div>

      <div class="text-center" style="margin-top: 3rem;">
        <p style="margin-bottom: 1.5rem; color: #6D3A55;">
          Tu organises un événement privé ou tu veux proposer une collaboration?
        </p>
        <a href="/contact" class="btn btn--secondary">Nous écrire</a>
      </div>
    </div>
  </section>

  <!-- ─── NEWSLETTER ─────────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <NewsletterSignup
        title="Ne manque pas la prochaine date"
        subtitle="Inscris-toi pour recevoir les nouvelles dates, les nouvelles offres, et les invitations en avant-première."
      />
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use '../styles/tokens' as *;

  .events-scene {
    position: relative;
    overflow: visible;
  }

  .events-totem {
    top: -8%;
    right: -3%;
    height: clamp(300px, 38vw, 540px);
    opacity: 0.4;

    @media (max-width: 900px) { display: none; }
  }

  .events-mass {
    z-index: 0;
  }

  .events-list {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: $space-6;
    margin-bottom: $space-8;
  }

  .event-card {
    padding: $space-6;
    position: relative;
  }

  .event-card__status {
    margin-bottom: $space-3;
  }

  .event-badge {
    font-size: $text-xs;
  }

  .event-card__title {
    font-family: $font-serif;
    font-size: $text-2xl;
    color: $color-encre;
    margin-bottom: $space-3;
  }

  .event-card__date,
  .event-card__location,
  .event-card__price {
    font-size: $text-sm;
    color: $color-encre;
    margin-bottom: $space-2;
    display: flex;
    align-items: center;
    gap: $space-2;
  }

  .event-card__date--tbd { color: $color-gris-moyen; font-style: italic; }

  .event-card__description {
    font-size: $text-sm;
    color: $color-gris-moyen;
    line-height: $leading-normal;
    margin-block: $space-4;
  }

  .events-empty-state {
    margin-top: $space-8;
  }

  .events-empty-inner {
    background-color: rgba($c-pink, 0.1);
    border-radius: 46% 54% 40% 60% / 12% 12% 88% 88%;
    padding: $space-12;
    text-align: center;
    box-shadow: $paint-shadow-ellipse;
  }

  .events-empty-icon {
    font-size: 3rem;
    color: $color-fuchsia;
    display: block;
    margin-bottom: $space-4;
  }

  .events-empty-inner h3 {
    font-family: $font-serif;
    font-size: $text-3xl;
    color: $color-encre;
    margin-bottom: $space-3;
  }

  .events-empty-inner p {
    color: $color-gris-moyen;
    font-size: $text-base;
    max-width: 480px;
    margin-inline: auto;
  }

  .formats-glimpse {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: $space-3;
    margin-top: $space-10;
  }

  .formats-glimpse__img {
    width: 320px;
    max-width: 100%;
    border-radius: $radius-md;
    object-fit: cover;
    object-position: center top;
    aspect-ratio: 16/9;
    box-shadow: $shadow-card;
  }

  .formats-glimpse__caption {
    font-size: $text-sm;
    color: $color-gris-moyen;
    font-style: italic;
  }

  .formats-grid {
    display: grid;
    gap: $space-5;
    grid-template-columns: 1fr;

    @include sm { grid-template-columns: repeat(2, 1fr); }
    @include lg { grid-template-columns: repeat(4, 1fr); }
  }

  .format-card {
    padding: $space-6 $space-5;
    display: flex;
    flex-direction: column;
    gap: $space-3;
  }

  .format-card__icon {
    font-size: 1.5rem;
    line-height: 1;
  }

  .format-card__title {
    font-family: $font-serif;
    font-size: $text-lg;
    color: $color-encre;
  }

  .format-card__desc {
    font-size: $text-sm;
    color: $color-gris-moyen;
    line-height: $leading-normal;
    flex: 1;
  }

  .format-card__status {
    font-size: $text-xs;
    font-weight: $weight-bold;
    color: $color-gris-moyen;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: auto;
  }


</style>
