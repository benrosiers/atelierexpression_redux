  // Twelve individual painted blotches — irregular silhouettes, varied
  // saturation, warm layered shadows, slight tilt and occasional overlap.
  // Deliberately not a uniform grid of identical disks.
  .express-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: $space-2;
    padding: $space-5 $space-3;
    text-align: center;
    transform: rotate(var(--tilt, 0deg));
    transition: transform $transition-base, box-shadow $transition-base;
    box-shadow: $paint-shadow-low;

    &:nth-child(6n+1) { border-radius: 42% 58% 61% 39% / 46% 42% 58% 54%; }
    &:nth-child(6n+2) { border-radius: 58% 42% 39% 61% / 54% 58% 42% 46%; }
    &:nth-child(6n+3) { border-radius: 50% 50% 65% 35% / 40% 60% 40% 60%; }
    &:nth-child(6n+4) { border-radius: 38% 62% 45% 55% / 60% 40% 65% 35%; }
    &:nth-child(6n+5) { border-radius: 64% 36% 55% 45% / 42% 58% 38% 62%; }
    &:nth-child(6n+6) { border-radius: 46% 54% 38% 62% / 55% 45% 62% 38%; }

    &:hover {
      transform: rotate(0deg) translateY(-4px) scale(1.05);
      box-shadow: $paint-shadow-mid;
      @include reduced-motion { transform: rotate(var(--tilt, 0deg)); }
