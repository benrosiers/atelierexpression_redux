---
import BaseLayout from '../components/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionIntro from '../components/SectionIntro.astro';
import ValuePillars from '../components/ValuePillars.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import InterestForm from '../components/InterestForm.astro';
import CindyInvitation from '../components/CindyInvitation.astro';
import DemoRecap from '../components/DemoRecap.astro';
import { testimonials as staticTestimonials } from '../data/testimonials';
import { faqs as staticFaqs } from '../data/faqs';
import { nextWorkshop as staticNextWorkshop } from '../data/nextWorkshop';
import Doodle from '../components/Doodle.astro';
import PaintDivider from '../components/PaintDivider.astro';
import { getTestimonials, getFaqs, getNextWorkshop, getSectionItems } from '../lib/content/publicContent';

const cmsTestimonials = await getTestimonials();
const testimonials = cmsTestimonials.length > 0 ? cmsTestimonials : staticTestimonials;

const cmsFaqs = await getFaqs();
const faqs = cmsFaqs.length > 0 ? cmsFaqs : staticFaqs;

const nextWorkshop = (await getNextWorkshop()) ?? staticNextWorkshop;

const staticExpressItems = [
  { word: 'Parler', doodle: 'speechBubble' as const },
  { word: 'Écrire', doodle: 'pencil' as const },
  { word: 'Bouger', doodle: 'dancer' as const },
  { word: 'Créer', doodle: 'palette' as const },
  { word: 'Chanter', doodle: 'notes' as const },
  { word: 'Rire', doodle: 'smile' as const },
  { word: 'Respirer', doodle: 'airWaves' as const },
  { word: 'Poser une limite', doodle: 'hand' as const },
  { word: 'Dire non', doodle: 'non' as const },
  { word: 'Dire oui', doodle: 'oui' as const },
  { word: 'Exister', doodle: 'star' as const },
  { word: 'Prendre ta place', doodle: 'sun' as const },
];
const cmsExpressItems = await getSectionItems('home', 'express-grid');
const expressItems = cmsExpressItems.length > 0
  ? cmsExpressItems.map((i) => ({ word: i.body ?? '', doodle: (i.iconKey ?? 'star') as any }))
  : staticExpressItems;

const staticForwhomCards = [
  { icon: 'heart' as const, text: 'Tu te sens coupé·e de toi-même et tu cherches une façon de te reconnecter.' },
  { icon: 'star' as const, text: 'Tu as toujours eu envie d\'essayer quelque chose comme ça, mais tu n\'as jamais osé.' },
  { icon: 'speechBubble' as const, text: 'Tu aimerais t\'exprimer plus librement — ta voix, ton corps, tes idées, tes émotions.' },
  { icon: 'smile' as const, text: 'Tu as l\'impression d\'avoir perdu quelque chose : ta légèreté, ton élan, ta spontanéité.' },
  { icon: 'leaf' as const, text: 'Tu veux grandir, mais avec du jeu, de la chaleur, et des gens vrais — pas des méthodes sérieuses.' },
  { icon: 'hand' as const, text: 'Tu as besoin d\'un espace où exister sans te rétrécir. Où essayer sans être jugé·e.' },
];
const cmsForwhomCards = await getSectionItems('home', 'forwhom-cards');
const forwhomCards = cmsForwhomCards.length > 0
  ? cmsForwhomCards.map((i) => ({ icon: (i.iconKey ?? 'star') as any, text: i.body ?? '' }))
  : staticForwhomCards;
---

<BaseLayout
  title="Accueil"
  description="Atelier Expression — Des ateliers joyeux pour adultes qui veulent se sentir plus vivants. Expression, voix, mouvement, rire. À Longueuil, Rive-Sud de Montréal."
  pageSlug="home"
>
  <!-- ─── HERO ─────────────────────────────────────────────────────────────── -->
  <Hero />

  <PaintDivider variant="hero" asset="wave-pink-peach" depth={0.28} />

  <!-- Scene A — hero → manifeste: giant peach mass + long rose ellipse
       overlapping, so no straight edge shows between the two sections.
       Bias kept upward reach well inside Hero's measured 242px clearance
       below its last CTA (giant: ~30% of ~460px rotated height ≈ 138px;
       long: ~20% of ~220px ≈ 44px — both safely under 242px). -->
  <div class="scene-seam" aria-hidden="true">
    <div class="paint-ellipse paint-ellipse--giant" style="--paint-ellipse-color:#FFE1CF; --paint-ellipse-tilt:-3deg; --paint-ellipse-bias:-30%;"></div>
    <div class="paint-ellipse paint-ellipse--long paint-ellipse--overlap paint-ellipse--soft" style="--paint-ellipse-color:#F02E8A; --paint-ellipse-tilt:4deg; --paint-ellipse-bias:-20%;"></div>
  </div>

  <!-- ─── CONTAINMENT SECTION (manifesto wave transition) ───────────────────── -->
  <section class="section section--contain" aria-labelledby="contain-heading">
    <div class="paint-scene" aria-hidden="true">
      <div
        class="paint-layer paint-layer--l1 contain__paint-wave"
        data-parallax
        data-parallax-depth="0.1"
        data-parallax-axis="y"
      >
        <img src="/assets/images/decor/paint-bold-wave.webp" alt="" width="1553" height="767" loading="lazy" />
      </div>
      <span
        class="paint-sparkle contain__sparkle"
        data-parallax
        data-parallax-depth="0.17"
        data-parallax-axis="y"
        aria-hidden="true"
        style="--sparkle-size: 1.3rem;"
      >🦋</span>
    </div>
    <div class="container">
      <div class="contain-layout">
        <div class="contain-left" data-reveal>
          <span class="accent-handwritten" style="color: #F02E8A">depuis longtemps</span>
          <h2 id="contain-heading" class="contain-heading">
            On t'a appris à te retenir.
          </h2>
          <p class="contain-intro">
            Dès l'enfance, les messages s'accumulent.
          </p>
          <ul class="contain-rules" role="list" aria-label="Messages reçus">
            {[
              'Sois sage.',
              'Ne pleure pas.',
              'Ne fais pas de vagues.',
              'Ne prends pas trop de place.',
              'Ne dérange pas.',
              'Rentre dans le cadre.',
            ].map((rule) => (
              <li class="contain-rule">
                <span aria-hidden="true">—</span>
                <em>{rule}</em>
              </li>
            ))}
          </ul>
        </div>

        <div class="contain-right" data-reveal="right">
          <div class="contain-consequence">
            <p class="contain-consequence__lead">
              Et peu à peu, quelque chose se bloque.
            </p>
            <p class="contain-consequence__body">
              On se coupe de ses émotions.
              L'énergie vivante n'a plus où aller.
              Le corps ralentit.
              Le système nerveux entre en mode survie.
              La vie intérieure devient silencieuse.
            </p>
            <p class="contain-consequence__body">
              Ce n'est pas une faiblesse. C'est ce qui arrive quand on retient trop longtemps
              ce qui aurait dû être vécu, exprimé, bougé.
            </p>
            <div class="contain-pivot">
              <p class="contain-pivot__text">
                L'humain n'a jamais été créé pour se contenir en permanence.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── IMMERSIVE PHOTO — full-width, Cindy au micro ──────────────────────── -->
  <div class="immersive-photo">
    <picture>
      <source srcset="/assets/images/cindy-invitation-micro.webp" type="image/webp" />
      <img
        src="/assets/images/cindy-invitation-micro.jpg"
        alt="Cindy, au micro, en pleine facilitation d'atelier"
        width="1400"
        height="788"
        loading="lazy"
      />
    </picture>
  </div>

  <PaintDivider variant="expressions" asset="bold-wave" flip depth={0.32} />

  <!-- ─── EXPRESSION MEANS ──────────────────────────────────────────────────── -->
  <section class="section section--express" aria-labelledby="express-heading">
    <div class="paint-scene" aria-hidden="true">
      <div
        class="logo-patch logo-patch--ambient-visible express__circle"
        data-parallax
        data-parallax-depth="0.11"
        data-parallax-axis="y"
      >
        <div class="logo-patch__frame">
          <img src="/assets/images/brand/atelier-expression-logo-mark.webp" alt="" width="1245" height="1245" loading="lazy" />
        </div>
      </div>
      <div
        class="paint-layer paint-layer--l2 express__mass"
        data-parallax data-parallax-depth="0.2" data-parallax-axis="y"
      >
        <img src="/assets/images/decor/paint-bold-flame.webp" alt="" width="828" height="1385" loading="lazy" />
      </div>
      <div class="express__doodle express__doodle--flower doodle--drift" style="animation-duration: 8s;">
        <Doodle name="flower" color="pink" />
      </div>
      <div class="express__doodle express__doodle--star doodle--rotate" style="animation-duration: 6.5s;">
        <Doodle name="star" color="orange" />
      </div>
      <div class="express__doodle express__doodle--leaf doodle--float" style="animation-duration: 9s;">
        <Doodle name="leaf" color="ink" />
      </div>
    </div>
    <div class="container">
      <div class="express-intro" data-reveal>
        <span class="accent-handwritten">ce que ça veut dire</span>
        <h2 id="express-heading" class="express-heading">
          S'exprimer, ce n'est pas seulement parler.
        </h2>
        <p class="express-sub">
          C'est retrouver tous les chemins que le corps et la voix peuvent emprunter.
        </p>
      </div>

      <div class="express-grid" data-reveal>
        {expressItems.map((item, i) => {
          const variant = ['orange', 'pink', 'coral', 'peach'][i % 4];
          const doodleColor = 'ink';
          return (
            <div
              class:list={['express-item', `express-item--${variant}`, i % 5 === 0 && 'express-item--overlap']}
              style={`--tilt: ${((i % 5) - 2) * 1.4}deg;`}
            >
              <span class="express-item__icon"><Doodle name={item.doodle} color={doodleColor as any} /></span>
              <span class="express-item__word">{item.word}</span>
            </div>
          );
        })}
      </div>

      <div class="express-coda" data-reveal>
        <p>
          Chaque expression libère de la vie.<br/>
          <strong>Ta vie mérite ta voix.</strong>
        </p>
      </div>
    </div>
  </section>

  <!-- ─── FOR WHOM — dense painted scene, not a two-column layout on a flat band -->
  <section class="section section--forwhom" aria-labelledby="forwhom-heading">
    <div class="paint-scene" aria-hidden="true">
      <div
        class="paint-layer paint-layer--l1 forwhom__mass"
        data-parallax data-parallax-depth="0.11" data-parallax-axis="y"
      >
        <img src="/assets/images/decor/paint-soft-peach.webp" alt="" width="1344" height="939" loading="lazy" />
      </div>
      <div
        class="paint-layer paint-layer--l2 forwhom__arc"
        data-parallax data-parallax-depth="0.18" data-parallax-axis="y"
      >
        <img src="/assets/images/decor/paint-bold-wave.webp" alt="" width="1553" height="767" loading="lazy" />
      </div>
      <div
        class="logo-patch logo-patch--ambient-visible forwhom__circle"
        data-parallax data-parallax-depth="0.13" data-parallax-axis="y"
      >
        <div class="logo-patch__frame">
          <img src="/assets/images/brand/atelier-expression-logo-mark.webp" alt="" width="1245" height="1245" loading="lazy" />
        </div>
      </div>
      <div class="forwhom__doodle forwhom__doodle--arrow doodle--drift" style="animation-duration: 8s;">
        <Doodle name="arrow" color="pink" />
      </div>
      <div class="forwhom__doodle forwhom__doodle--star doodle--rotate" style="animation-duration: 6s;">
        <Doodle name="star" color="orange" />
      </div>
      <div class="forwhom__doodle forwhom__doodle--dots doodle--pulse" style="animation-duration: 5.5s;">
        <Doodle name="dots" color="ink" />
      </div>
    </div>
    <div class="container">
      <div class="forwhom-grid">
        <div class="forwhom-intro" data-reveal>
          <span class="accent-handwritten">est-ce pour toi?</span>
          <h2 id="forwhom-heading">Tu n'as pas besoin d'être à l'aise pour commencer.</h2>
          <div class="divider"></div>
          <p class="forwhom-lead">
            Ces ateliers sont précisément pour les personnes qui ne le sont pas encore.
          </p>
        </div>

        <div class="forwhom-cards" data-reveal="right">
          {forwhomCards.map((item, i) => (
            <div class:list={['paint-card', i % 2 === 0 ? 'paint-card--pink' : 'paint-card--orange']}>
              <span class="forwhom-card__icon"><Doodle name={item.icon} color={i % 2 === 0 ? 'pink' : 'orange'} /></span>
              <p class="forwhom-card__text">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <PaintDivider variant="manifest" asset="wave-pink-peach" flip depth={0.22} />

  <!-- Scene D (entry) — curved limit into the red/orange atelier band: one
       giant deep-red/orange mass overlapping both neighbors. -->
  <div class="scene-seam" aria-hidden="true">
    <div class="paint-ellipse paint-ellipse--giant paint-ellipse--dense paint-ellipse--overlap" style="--paint-ellipse-color:#C94222; --paint-ellipse-tilt:-2deg; --paint-ellipse-bias:-50%;"></div>
  </div>

  <!-- ─── WORKSHOP INTRO FEATURE — painted scene, no more cropped photo ─────── -->
  <section class="section band band--encre section--workshop-feature" aria-labelledby="workshop-feat-heading">
    <div class="paint-scene" aria-hidden="true">
      <div
        class="paint-layer paint-layer--l3 wf__brush"
        data-parallax data-parallax-depth="0.16" data-parallax-axis="y"
      >
        <img src="/assets/images/decor/paint-bold-crescent.webp" alt="" width="1322" height="1037" loading="lazy" />
      </div>
      <div class="wf__doodle wf__doodle--sparkle doodle--pulse" style="animation-duration: 5s;">
        <Doodle name="sparkle" color="pink" />
      </div>
      <div class="wf__doodle wf__doodle--spiral doodle--rotate" style="animation-duration: 9s;">
        <Doodle name="spiral" color="orange" />
      </div>
    </div>
    <div class="container">
      <div class="wf-layout">
        <div class="wf-badge-col" data-reveal="left">
          <div class="wf-badge">
            <span class="wf-badge__icon"><Doodle name="sparkle" color="pink" /></span>
            <span class="wf-badge__label">Atelier découverte</span>
            <span class="wf-badge__price">{nextWorkshop.price}</span>
            <span class="wf-badge__duration">2 heures</span>
            <span class="wf-badge__group">{nextWorkshop.capacity}</span>
          </div>
        </div>

        <div class="wf-content" data-reveal>
          <span class="accent-handwritten" style="color: #FF5A1F">le format qu'on prépare</span>
          <h2 id="workshop-feat-heading" class="wf-title">
            Ici, on ose.<br/>On rit. On vit plus pleinement.
          </h2>
          <p class="wf-body">
            Deux heures. Un petit groupe. Un espace où on ne vient pas performer — on vient essayer.
            Des jeux simples, des rires vrais, du mouvement, des voix, et un cercle de partage
            à la fin. Aucun talent requis. Aucune bonne façon d'être là.
          </p>

          <h3 class="wf-subtitle">Ce qui se passe en 2 heures :</h3>
          <ol class="wf-steps">
            {[
              'Accueil et sécurité — on pose le cadre ensemble',
              'Jeux simples pour briser la glace (vraiment briser)',
              'Rire et mouvement guidé — le corps se réveille',
              'Voix, présence, mini-expressions — sans pression',
              'Cercle de partage léger',
              'Retour au calme et prochaine invitation',
            ].map((step, i) => (
              <li class="wf-step">
                <span class="wf-step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span>{step}</span>
              </li>
            ))}
          </ol>

          <div class="wf-ctas">
            <a
              href={nextWorkshop.status === 'building' ? '#interet-prochain-atelier' : '/reserver'}
              class="btn btn--primary btn--lg"
            >
              {nextWorkshop.status === 'building' ? nextWorkshop.ctaLabel : 'Réserver ma place'}
            </a>
            <a href="/ateliers" class="btn btn--outline-white">Tout savoir sur l'atelier</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── CINDY'S INVITATION (filmed before the demo workshop existed) ──────── -->
  <CindyInvitation />

  <!-- ─── DEMO WORKSHOP RECAP (real group session, 2026-07-08, Longueuil) ───── -->
  <DemoRecap />

  <!-- ─── NEXT WORKSHOP — EN PRÉPARATION + INTÉRÊT ──────────────────────────── -->
  <section class="section band band--pink-soft section--next-workshop" aria-labelledby="next-workshop-heading" id="prochain-atelier">
    <div class="paint-scene" aria-hidden="true">
      <div
        class="paint-layer paint-layer--l1 nw__mass"
        data-parallax data-parallax-depth="0.13" data-parallax-axis="y"
      >
        <img src="/assets/images/decor/paint-cluster-pink-peach.webp" alt="" width="1029" height="1269" loading="lazy" />
      </div>
      <div class="nw__doodle nw__doodle--envelope doodle--float" style="animation-duration: 7s;">
        <Doodle name="speechBubble" color="pink" />
      </div>
      <div class="nw__doodle nw__doodle--sparkle doodle--pulse" style="animation-duration: 5.5s;">
        <Doodle name="sparkle" color="orange" />
      </div>
    </div>
    <div class="container">
      <div class="nw-layout">
        <div class="nw-intro" data-reveal="left">
          <span class="accent-handwritten">le prochain atelier</span>
          <h2 id="next-workshop-heading" class="nw-heading">La prochaine édition se prépare.</h2>
          <p class="nw-body">{nextWorkshop.details}</p>
          <p class="nw-body nw-body--emphasis">
            Laisse ton courriel pour recevoir la date dès qu'elle sera annoncée.
            Aucun engagement — seulement la priorité quand les inscriptions ouvriront.
          </p>
        </div>
        <div class="nw-form-col" data-reveal="right">
          <InterestForm />
        </div>
      </div>
    </div>
  </section>

  <!-- ─── TRANSFORMATION ────────────────────────────────────────────────────── -->
  <section class="section section--transform" aria-labelledby="transform-heading">
    <div class="container">
      <SectionIntro
        accent="avant / après"
        title="On commence par un rire nerveux. C'est déjà une porte."
        centered
      />

      <div class="transform-grid" data-reveal>
        <div class="transform-col transform-col--before">
          <div class="transform-label transform-label--before">Avant</div>
          <ul class="transform-list" role="list">
            {[
              'Se retenir',
              'S\'adapter',
              'Se couper de soi',
              'Minimiser',
              'Figer',
              'Survivre',
              'Rester petit·e',
            ].map((item) => (
              <li class="transform-item transform-item--before">
                <span aria-hidden="true">✕</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="transform-arrow" aria-hidden="true">
          <div class="transform-arrow__line"></div>
          <div class="transform-arrow__label">
            <span class="accent-handwritten" style="font-size: 1.1rem">après l'atelier</span>
          </div>
        </div>

        <div class="transform-col transform-col--after">
          <div class="transform-label transform-label--after">Après</div>
          <ul class="transform-list" role="list">
            {[
              'Ressentir',
              'Bouger',
              'Respirer',
              'Jouer',
              'Prendre sa place',
              'Retrouver sa voix',
              'Reconnecter à son élan',
            ].map((item) => (
              <li class="transform-item transform-item--after">
                <span aria-hidden="true">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── PILLARS ────────────────────────────────────────────────────────────── -->
  <section class="section band band--gris section--pillars" aria-labelledby="pillars-heading">
    <div class="paint-scene" aria-hidden="true">
      <div
        class="paint-layer paint-layer--l2 pillars__wave"
        data-parallax data-parallax-depth="0.15" data-parallax-axis="y"
      >
        <img src="/assets/images/decor/paint-bold-wave.webp" alt="" width="1553" height="767" loading="lazy" />
      </div>
      <div
        class="logo-patch logo-patch--ambient-visible pillars__circle"
        data-parallax data-parallax-depth="0.12" data-parallax-axis="y"
      >
        <div class="logo-patch__frame">
          <img src="/assets/images/brand/atelier-expression-logo-mark.webp" alt="" width="1245" height="1245" loading="lazy" />
        </div>
      </div>
      <div class="pillars__doodle pillars__doodle--star doodle--rotate" style="animation-duration: 7s;">
        <Doodle name="star" color="orange" />
      </div>
      <div class="pillars__doodle pillars__doodle--leaf doodle--float" style="animation-duration: 8.5s;">
        <Doodle name="leaf" color="ink" />
      </div>
    </div>
    <div class="container">
      <SectionIntro
        accent="la méthode"
        title="Six portes pour retrouver sa place."
        subtitle="Chaque atelier passe par ces six dimensions. Pas toutes en profondeur — mais chacune ouverte, juste un peu."
        centered
      />
      <ValuePillars />
    </div>
  </section>

  <!-- ─── CINDY INTRO ────────────────────────────────────────────────────────── -->
  <section class="section section--cindy" aria-labelledby="cindy-heading">
    <div class="container">
      <div class="cindy-layout">
        <div class="cindy-visual" data-reveal="left">
          <div class="cindy-img-wrap">
            <img
              src="/assets/images/cindy_01.png"
              alt="Cindy — facilitatrice et animatrice d'Atelier Expression"
              class="cindy-img"
              width="400"
              height="480"
              loading="lazy"
            />
          </div>
          <div class="cindy-doodle" aria-hidden="true">
            <svg viewBox="0 0 100 100" width="80" height="80" fill="none">
              <path d="M50 10 Q70 30 60 50 Q50 70 30 60 Q10 50 20 30 Q30 10 50 10Z" stroke="#FF5A1F" stroke-width="2" fill="none"/>
              <circle cx="50" cy="50" r="4" fill="#FF5A1F"/>
            </svg>
          </div>
        </div>

        <div class="cindy-content" data-reveal>
          <span class="accent-handwritten">la facilitatrice</span>
          <div class="cindy-bar" aria-hidden="true"></div>
          <h2 id="cindy-heading">Cindy ouvre des espaces où les adultes peuvent revenir à eux-mêmes.</h2>
          <p class="cindy-core-message">
            Elle ne demande à personne ce qu'elle ne se demande pas à elle-même : Cindy tente
            constamment d'incarner ce qu'elle enseigne.
          </p>
          <p class="cindy-body">
            Elle n'enseigne pas. Elle transmet. Elle n'impose pas. Elle crée les conditions
            pour que quelque chose s'ouvre — doucement, joyeusement, sans forcer.
          </p>
          <p class="cindy-body">
            Cindy croit que l'expression n'est pas réservée aux artistes ou aux personnes
            "à l'aise". Elle appartient à tout le monde — et surtout à celles et ceux qui
            pensent qu'elle n'est pas pour eux.
